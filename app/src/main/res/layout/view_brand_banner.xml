<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="" android:src="@drawable/ic_brand" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif-medium" android:letterSpacing="0.04" android:text="@string/brand_name" android:textColor="@color/text_primary" android:textSize="21sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-light" android:letterSpacing="0.14" android:text="@string/your_entrance_always_with_you" android:textColor="@color/text_secondary" android:textSize="9sp" />
            </LinearLayout>
</LinearLayout>
